#!/usr/bin/env bash
# Runs the fast gate before each commit: formatting checks and unit tests, no
# full builds. scripts/verify.sh is the single source of truth for what "green"
# means; gates whose toolchain is missing are skipped and listed there.
#
# Skip with `git commit --no-verify` in an emergency.

set -e
exec bash "$(git rev-parse --show-toplevel)/scripts/verify.sh" --fast
