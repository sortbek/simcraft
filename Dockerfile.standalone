# --- Stage 1: Build the Frontend (static export) ---
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY frontend/ .
# DESKTOP_BUILD=1 triggers output:"export" in next.config.mjs and unoptimized images
# NEXT_PUBLIC_API_URL="" makes all API calls relative (e.g. /api/sim), so the
# Rust backend serves both the UI and the API on the same port.
ENV DESKTOP_BUILD=1
ENV NEXT_PUBLIC_API_URL=""
RUN npm run build

# --- Stage 2: Build the Rust Backend ---
# Keep this version in step with backend/rust-toolchain.toml; FROM cannot read it.
FROM rust:1.96-alpine AS backend-builder
RUN apk add --no-cache musl-dev
WORKDIR /build
# Without Cargo.lock cargo resolves every dependency from scratch, so this image
# can ship a different dependency graph than the one CI tested. `--locked` makes
# that enforceable: the build fails if the lockfile drifts from the manifests.
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/core/ core/
COPY backend/server/ server/
COPY backend/calibration/ calibration/
COPY backend/migrations/ migrations/
RUN cargo build --release --locked -p simhammer-server

# --- Stage 3: Final Runtime ---
# Node.js is needed to run compact-data.js at startup.
# Debian trixie provides glibc 2.40, required by SimC binaries (glibc >= 2.38).
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq bash nodejs locales \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8

WORKDIR /app

# Bake in the static frontend
COPY --from=frontend-builder /app/out /app/frontend

# Bake in the Rust server binary
COPY --from=backend-builder /build/target/release/simhammer-server /usr/local/bin/simhammer-server

# Bake in the data compaction script and the default season config
COPY backend/scripts/compact-data.js /app/compact-data.js
COPY backend/core/season-config.json /app/default_season_config.json

# Bake in the offline-generated MDT route data (enemy DB + map tiles). It isn't
# part of the Raidbots/Blizzard fetch, so the entrypoint drops it into DATA_DIR.
COPY backend/resources/data/mdt_dungeons.json /app/mdt_dungeons.json
COPY backend/resources/data/mdt-maps/ /app/mdt-maps/

# Bake in the entrypoint
COPY standalone-entrypoint.sh /app/standalone-entrypoint.sh
RUN chmod +x /app/standalone-entrypoint.sh

# Volumes for persistent caching of fetched game data, the simc binary, and the SQLite db
VOLUME ["/app/resources/data", "/app/resources/data_full", "/app/resources/simc", "/app/db"]

ENV DATA_DIR=/app/resources/data
ENV SIMC_PATH=/usr/local/bin/simc
ENV FRONTEND_DIR=/app/frontend
ENV DATABASE_URL=/app/db/simhammer.db
ENV BIND_HOST=0.0.0.0
ENV PORT=8000
ENV MAX_SCENARIOS=10

EXPOSE 8000
ENTRYPOINT ["/app/standalone-entrypoint.sh"]
CMD ["simhammer-server"]
